<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title is defined %}{{ title }} · {% endif %}Kiln blog</title>
  <style>
    body { font: 16px/1.6 system-ui, sans-serif; max-width: 42rem; margin: 3rem auto; padding: 0 1rem; color: #1b1e22; }
    a { color: #a3401b; }
    .meta { color: #5a6370; font-size: .9rem; }
    li { margin-bottom: .75rem; }
  </style>
</head>
<body>
  <header><a href="{{ path("posts::index") }}">Kiln blog</a></header>
  <main>{{ content }}</main>
</body>
</html>
