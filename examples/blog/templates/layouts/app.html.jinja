<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg">
  <title>{% if title is defined %}{{ title }} · {% endif %}Kiln blog</title>
  {# Apply the saved theme before first paint (no flash); assets/application.js does the rest. #}
  <script>try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t } catch {}</script>
  <link rel="stylesheet" href="{{ asset("app.css") }}">
  {{ csrf_meta() }}
  {{ javascript_importmap() }}
</head>
<body>
  <header>
    <a href="{{ path("posts::index") }}">Kiln blog</a>
    <nav>
      {% if current_user %}
      <a href="{{ path("sign_ins::index") }}">{{ current_user.name }}</a>
      <a href="{{ path("posts::new") }}">New post</a>
      {{ form_start(path("sessions::destroy"), method="delete", class="inline") }}<button>Sign out</button>{{ form_end() }}
      {% else %}
      <a href="{{ path("sessions::new") }}">Sign in</a>
      <a href="{{ path("registrations::new") }}">Sign up</a>
      {% endif %}
      {% include "layouts/_theme_switcher.html.jinja" %}
    </nav>
  </header>
  {% for kind, message in flash | items %}
  <p class="flash {{ kind }}">{{ message }}</p>
  {% endfor %}
  <main>{{ content }}</main>
</body>
</html>
