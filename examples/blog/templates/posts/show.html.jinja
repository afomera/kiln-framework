{% set title = post.title %}
<article>
  <h1>{{ post.title }}{% if post.is_draft %} <small>(draft)</small>{% endif %}</h1>
  <p class="meta">{{ by_line }} · {{ post.reading_time }}{% if post.editor %} · edited by {{ post.editor.name }}{% endif %}</p>
  {% if post.cover %}<img class="cover" src="{{ post.cover.url }}" alt="">{% endif %}
  {{ post.body | rich_text }}
  {% if can_edit %}
  <p>
    <a href="{{ path("posts::edit", slug=post.slug) }}">Edit</a>
    {{ button_to("Delete", path("posts::destroy", slug=post.slug), method="delete", class="inline", confirm="Delete “" ~ post.title ~ "”? This can't be undone.", confirm_button="Delete post", tone="danger") }}
  </p>
  {% endif %}
</article>
<section>
  <h2>Comments</h2>
  {# Live: new comments from anyone appear without a reload. #}
  {{ turbo_stream_from("post:" ~ post.id) }}
  <ul id="comments">
    {% for comment in post.comments %}{% include "comments/_comment.html.jinja" %}{% endfor %}
  </ul>
  {% if current_user %}
  {% with form = comment_form, post_slug = post.slug %}{% include "comments/_form.html.jinja" %}{% endwith %}
  {% else %}
  <p><a href="{{ path("sessions::new") }}">Sign in</a> to comment.</p>
  {% endif %}
</section>
