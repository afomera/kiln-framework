{% set title = "Bookmarks" %}
<h1>Bookmarks</h1>
{% if current_user %}
<p><a href="{{ path("bookmarks::new") }}">New bookmark</a></p>
{% endif %}
{% if bookmarks %}
<ul>
  {% for bookmark in bookmarks %}
  <li><a href="{{ path("bookmarks::show", id=bookmark.id) }}">{{ bookmark.title }}</a>{% if bookmark.pinned %} (pinned){% endif %}</li>
  {% endfor %}
</ul>
{{ form_start(path("bookmarks::pins"), method="patch") }}
  {{ field(form.pinned, label="Pinned", options=bookmarks, option_value="id", option_label="title") }}
  <button>Save pins</button>
{{ form_end() }}
{% else %}
<p>No bookmarks yet.</p>
{% endif %}
