{% set title = "Where you're signed in" %}
<h1>Where you're signed in</h1>
<p><a href="{{ path("password_settings::edit") }}">Change your password</a></p>
<p><a href="{{ path("api_tokens::index") }}">API tokens</a></p>
<ul class="sign-ins">
  {% for sign_in in sign_ins %}
  <li id="sign_in_{{ sign_in.id }}">
    <strong>{{ sign_in.device }}</strong>{% if sign_in.current %} · this browser{% endif %}
    <br><small>{{ sign_in.ip or "Unknown address" }} · signed in {{ sign_in.created_at | datetime }} · last active {{ sign_in.last_seen_at | time_ago }}</small>
    {% if not sign_in.current %}
    {{ button_to("Sign out", path("sign_ins::destroy", id=sign_in.id), method="delete", class="inline", confirm="Sign out " ~ sign_in.device ~ "?", confirm_button="Sign out") }}
    {% endif %}
  </li>
  {% endfor %}
</ul>
{% if sign_ins | length > 1 %}
{{ button_to("Sign out everywhere else", path("sign_ins::destroy_others"), method="delete", confirm="Sign out every other device? You'll stay signed in here.", confirm_button="Sign them out", tone="danger") }}
{% endif %}
