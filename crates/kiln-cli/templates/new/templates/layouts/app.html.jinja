<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.svg">
  <title>{% if title is defined %}{{ title }} · {% endif %}@@App@@</title>
  <link rel="stylesheet" href="{{ asset("app.css") }}">
  {{ csrf_meta() }}
  {{ javascript_importmap() }}
</head>
<body>
  <header>
    <a href="/">@@App@@</a>
    <nav>
      {% if current_user %}
      <span>{{ current_user.name }}</span>
      {{ form_start(path("sessions::destroy"), method="delete", class="inline") }}<button>Sign out</button>{{ form_end() }}
      {% else %}
      <a href="{{ path("sessions::new") }}">Sign in</a>
      {% endif %}
    </nav>
  </header>
  {% for kind, message in flash | items %}
  <p class="flash {{ kind }}">{{ message }}</p>
  {% endfor %}
  <main>{{ content }}</main>
</body>
</html>
