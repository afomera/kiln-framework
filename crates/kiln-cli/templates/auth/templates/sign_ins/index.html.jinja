{% set title = "Where you're signed in" %}
<h1>Where you're signed in</h1>
<p><a href="{{ path("password_settings::edit") }}">Change your password</a></p>
<ul class="sign-ins">
  {% for sign_in in sign_ins %}
  <li id="sign_in_{{ sign_in.id }}">
    <strong>{{ sign_in.device }}</strong>{% if sign_in.current %} · this browser{% endif %}
    <br><small>{{ sign_in.ip or "Unknown address" }} · signed in {{ sign_in.created_at | datetime }} · last active {{ sign_in.last_seen_at | datetime }}</small>
    {% if not sign_in.current %}
    {{ form_start(path("sign_ins::destroy", id=sign_in.id), method="delete", class="inline") }}<button>Sign out</button>{{ form_end() }}
    {% endif %}
  </li>
  {% endfor %}
</ul>
{% if sign_ins | length > 1 %}
{{ form_start(path("sign_ins::destroy_others"), method="delete") }}<button>Sign out everywhere else</button>{{ form_end() }}
{% endif %}
